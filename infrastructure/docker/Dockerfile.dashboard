FROM node:22-alpine AS build

WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/dashboard ./apps/dashboard
COPY packages ./packages

# Vite inlines this at build time. Empty keeps the app default of the
# same-origin /api/v1; set it when the API lives on another host.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

RUN pnpm install --no-frozen-lockfile \
    && pnpm --filter dashboard build

FROM nginx:1.27-alpine
COPY infrastructure/docker/dashboard.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/dashboard/dist /usr/share/nginx/html
EXPOSE 5173
