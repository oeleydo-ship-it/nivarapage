# UiDesired - Custom Docker environment variables.
#
#   Image:          YOUR_REGISTRY/uidesired:uplary
#   Container port: 8080
#   Persistent volume: /data          <-- REQUIRED. The database, uploads, the
#                                         app key and the Reverb secret all
#                                         live here. Without it every redeploy
#                                         starts from an empty database.
#
# Everything below has a working default baked into the image. The variables
# marked REQUIRED are the ones you genuinely have to set for a real domain.

# ---------------------------------------------------------------- application
APP_ENV=production
APP_DEBUG=false
# Leave blank on the first deploy: a key is generated and kept at /data/app-key.
APP_KEY=

# REQUIRED. Where the dashboard and API are served.
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com

# REQUIRED. The wildcard customers' published sites are served from. Must match
# the DNS record, e.g. *.sites.example.com.
PLATFORM_DOMAIN=sites.example.com
RENDERER_URL=https://sites.example.com
PREVIEW_DOMAIN=preview.sites.example.com
CLOUDFLARE_FALLBACK_ORIGIN=fallback.sites.example.com

# REQUIRED for login to work: session cookies are rejected otherwise.
SANCTUM_STATEFUL_DOMAINS=app.example.com
SESSION_SECURE_COOKIE=true

# Shared secret the renderer uses when it calls the API. Any long random string.
INTERNAL_RENDERER_SECRET=

# ------------------------------------------------------------------- database
#
# DB_EMBEDDED controls where the database comes from:
#
#   true   Use the MariaDB bundled in this image. Nothing external needed.
#          Data goes to /data/mysql. This is the setting for a standalone
#          deployment on a panel that does not provision a database.
#
#   auto   (image default) Try the external server at DB_HOST first, and fall
#          back to the bundled MariaDB if nothing answers within
#          DB_WAIT_SECONDS. Once the bundled database holds data it keeps
#          being used, so a network blip cannot move the app onto an empty one.
#
#   false  External only. The container serves the dashboard and health check
#          while it waits, and restarts itself once the database answers.
#
DB_CONNECTION=mysql
DB_EMBEDDED=true

DB_DATABASE=uidesired
DB_USERNAME=uidesired
# Leave blank with DB_EMBEDDED=true: a password is generated on first boot and
# kept at /data/db-password. Set it only for an external server.
DB_PASSWORD=

# Only used when DB_EMBEDDED is auto or false. Managed panels usually rename
# the service to {slug}-db; the container probes the common names either way.
DB_HOST=db
DB_PORT=3306
# How long to wait for an external server before giving up (seconds).
DB_WAIT_SECONDS=60

# Schema and seed data. All are idempotent, so leaving them on is safe.
RUN_MIGRATIONS=true
SEED_TEMPLATES=true
SEED_SUPER_ADMIN=true
SEED_DEMO=false

# REQUIRED. Change these before the first boot - the image defaults are public.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_USERNAME=admin@example.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# -------------------------------------------------------- cache, queue, redis
# Redis runs inside the container; these need no changes.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
HORIZON_MAX_PROCESSES=3

# ------------------------------------------------------------------ websocket
# REVERB_HOST is the public hostname browsers connect to; the rest describe the
# server inside the container and need no changes. Leaving the secret blank
# generates one and keeps it at /data/reverb-secret.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=uidesired
REVERB_APP_KEY=uidesiredkey
REVERB_APP_SECRET=
REVERB_HOST=app.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081

# ------------------------------------------------------------------- internal
# The renderer talks to the API over the loopback interface. Do not change.
API_URL=http://127.0.0.1:8000
