# Tuning for the MariaDB instance bundled inside the UiDesired image.
# It only ever serves processes in this container, so it never listens off-host.
[mysqld]
user                    = mysql
datadir                 = /data/mysql
socket                  = /run/mysqld/mysqld.sock
pid-file                = /run/mysqld/mysqld.pid
bind-address            = 127.0.0.1
skip-name-resolve

character-set-server    = utf8mb4
collation-server        = utf8mb4_unicode_ci

# A single container shares its memory with PHP, Node, Redis and Caddy, so the
# defaults for a dedicated database host are far too generous here.
innodb_buffer_pool_size = 128M
innodb_log_file_size    = 64M
innodb_flush_method     = O_DIRECT
max_connections         = 100
table_open_cache        = 256

# Laravel's default string length plus a utf8mb4 index fits in the 3072-byte
# limit only with DYNAMIC row format, which is the default here but is worth
# pinning so an older my.cnf on a mounted volume cannot change it.
innodb_default_row_format = dynamic

[client]
socket                  = /run/mysqld/mysqld.sock
default-character-set   = utf8mb4
