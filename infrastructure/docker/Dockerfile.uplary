# Single image for Uplary Cloud → Applications → Custom Docker.
# Traefik / Custom Docker publishes ONE port. This image listens on 8080.
# Set DB_HOST=db (and DB_DATABASE / DB_USERNAME / DB_PASSWORD) so Uplary
# creates a MariaDB sidecar on the same Docker network.

FROM node:22-bookworm-slim AS dashboard-build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/dashboard ./apps/dashboard
COPY packages ./packages
ENV VITE_API_URL=/api/v1
RUN pnpm install --no-frozen-lockfile \
    && pnpm --filter dashboard build

FROM node:22-bookworm-slim AS renderer-build
WORKDIR /app
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/renderer ./apps/renderer
COPY packages ./packages
ENV NEXT_TELEMETRY_DISABLED=1
ENV API_URL=http://127.0.0.1:8000
RUN pnpm install --no-frozen-lockfile \
    && pnpm --filter renderer build

FROM php:8.4-cli-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        curl \
        unzip \
        supervisor \
        redis-server \
        mariadb-server \
        mariadb-client \
        libpng-dev \
        libjpeg62-turbo-dev \
        libfreetype6-dev \
        libzip-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) pcntl posix pdo_mysql gd zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/* /var/lib/mysql

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY --from=caddy:2 /usr/bin/caddy /usr/bin/caddy
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node
RUN mkdir -p /etc/caddy /srv/dashboard /opt/renderer /data/redis /data/storage \
        /run/mysqld /data/mysql \
    && chown mysql:mysql /run/mysqld /data/mysql

COPY infrastructure/docker/php.ini /usr/local/etc/php/conf.d/uidesired.ini
# 99- so it is read after the packaged 50-server.cnf and wins.
COPY infrastructure/docker/mariadb.uidesired.cnf /etc/mysql/mariadb.conf.d/99-uidesired.cnf
COPY infrastructure/docker/supervisord.conf /etc/supervisor/supervisord.conf
COPY infrastructure/docker/supervisord.uplary.conf /etc/supervisor/conf.d/uidesired.conf
COPY infrastructure/docker/uplary-entrypoint.sh /usr/local/bin/uplary-entrypoint.sh
COPY infrastructure/docker/uplary-db.sh /usr/local/bin/uplary-db.sh
# A clone made on Windows can carry CRLF into the image; sh and supervisor
# both choke on the trailing carriage return.
RUN chmod +x /usr/local/bin/uplary-entrypoint.sh \
    && sed -i 's/\r$//' /usr/local/bin/uplary-entrypoint.sh \
        /usr/local/bin/uplary-db.sh \
        /etc/mysql/mariadb.conf.d/99-uidesired.cnf \
        /etc/supervisor/supervisord.conf \
        /etc/supervisor/conf.d/uidesired.conf \
        /usr/local/etc/php/conf.d/uidesired.ini

WORKDIR /var/www/html
COPY apps/api /var/www/html
# The build context prunes local storage state, so the tree can be missing
# directories Laravel expects to exist before anything writes to them.
RUN mkdir -p storage/app/public storage/framework/cache/data \
        storage/framework/sessions storage/framework/views storage/logs \
        bootstrap/cache \
    && composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader \
    && chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

COPY --from=dashboard-build /app/apps/dashboard/dist /srv/dashboard
COPY --from=renderer-build /app/apps/renderer/.next/standalone /opt/renderer
COPY --from=renderer-build /app/apps/renderer/.next/static /opt/renderer/apps/renderer/.next/static
COPY --from=renderer-build /app/apps/renderer/public /opt/renderer/apps/renderer/public

ENV APP_ENV=production \
    APP_DEBUG=false \
    RUN_MIGRATIONS=true \
    SEED_TEMPLATES=true \
    SEED_SUPER_ADMIN=true \
    SUPER_ADMIN_EMAIL=admin@uidesired.test \
    SUPER_ADMIN_USERNAME=admin@uidesired.test \
    SUPER_ADMIN_PASSWORD=password \
    SUPER_ADMIN_NAME="Super Admin" \
    SEED_DEMO=false \
    DB_CONNECTION=mysql \
    DB_EMBEDDED=auto \
    DB_HOST=db \
    DB_PORT=3306 \
    DB_DATABASE=uidesired \
    DB_USERNAME=uidesired \
    REDIS_HOST=127.0.0.1 \
    REDIS_PORT=6379 \
    QUEUE_CONNECTION=redis \
    CACHE_STORE=redis \
    SESSION_DRIVER=redis \
    BROADCAST_CONNECTION=reverb \
    REVERB_SERVER_HOST=127.0.0.1 \
    REVERB_SERVER_PORT=8081 \
    REVERB_PORT=443 \
    REVERB_SCHEME=https \
    API_URL=http://127.0.0.1:8000 \
    PHP_CLI_SERVER_WORKERS=4 \
    HORIZON_MAX_PROCESSES=3 \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

EXPOSE 8080
VOLUME ["/data"]

LABEL org.opencontainers.image.title="UiDesired" \
      org.opencontainers.image.description="Uplary Cloud Custom Docker image (dashboard, API, renderer, Redis, Horizon)" \
      io.uplary.container-port="8080"

HEALTHCHECK --interval=20s --timeout=15s --start-period=240s --retries=10 \
    CMD curl -fsS http://127.0.0.1:8080/api/v1/health || exit 1

ENTRYPOINT ["uplary-entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
