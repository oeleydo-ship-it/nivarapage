FROM node:22-alpine AS build

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-workspace.yaml ./
COPY apps/renderer ./apps/renderer
COPY packages ./packages

ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm install --no-frozen-lockfile \
    && pnpm --filter renderer build

FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache wget
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=build /app/apps/renderer/public ./apps/renderer/public
COPY --from=build /app/apps/renderer/.next/standalone ./
COPY --from=build /app/apps/renderer/.next/static ./apps/renderer/.next/static

EXPOSE 3000
CMD ["node", "apps/renderer/server.js"]
