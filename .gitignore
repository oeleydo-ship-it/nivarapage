# Laravel runtime state. The application lives at the repository root, so these
# are anchored with a leading slash - `apps/dashboard/storage` is not this.
/storage/*.key
/storage/pail
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
!/storage/logs/.gitkeep
!/storage/framework/cache/data/.gitkeep
!/storage/framework/sessions/.gitkeep
!/storage/framework/views/.gitkeep
/bootstrap/cache/*.php
!/bootstrap/cache/.gitkeep
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

playwright-report/
test-results/
.pnpm-store/
*.tsbuildinfo
tmp-*.html
tmp-*.txt
tmp-*.mjs
tmp-upload-probe/

# Front-end build output. Produced by `pnpm build` on deploy and served by
# Laravel; committing it would put two sources of truth in the repo.
/public/dashboard/
/public/site/

# Local databases.
/database/*.sqlite

# Leftover from the flatten: a Herd php-cgi worker holds this file open.
# Delete apps/ once Herd is restarted; nothing reads it any more.
/apps/api/
