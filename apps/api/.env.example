APP_NAME=UiDesired
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5174
RENDERER_URL=http://localhost:3100
PLATFORM_DOMAIN=sites.localhost
PREVIEW_DOMAIN=preview.localhost
INTERNAL_RENDERER_SECRET=
SEED_DEMO=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
MEDIA_DISK=public
# Preferred media destination for new uploads. Super-admin Storage settings can
# override this at runtime (local | aws_s3 | digitalocean | cloudflare_r2 | wasabi | s3_compatible).
# AWS_*/R2_*/WASABI_* below are env fallbacks when Admin credentials are not set.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# Public site JSON TTL in seconds (domain, theme, nav, published pages).
PUBLIC_CACHE_TTL=86400

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_BUCKET=
WASABI_REGION=us-east-1
WASABI_ENDPOINT=
WASABI_URL=
WASABI_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost:5174,app.localhost

DOMAIN_PROVIDER=fake
CLOUDFLARE_SAAS_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
# Hostname inside your zone that custom hostnames fall back to, e.g. fallback.example.com
CLOUDFLARE_FALLBACK_ORIGIN=
# What customers CNAME to. Defaults to the fallback origin when unset.
CLOUDFLARE_CNAME_TARGET=
# Optional A records for apex domains whose registrar has no ALIAS/ANAME support.
CLOUDFLARE_APEX_IPS=
# txt lets customers validate before their DNS points here. Do not use http.
CLOUDFLARE_SSL_VALIDATION=txt
CLOUDFLARE_MIN_TLS_VERSION=1.2
CLOUDFLARE_WEBHOOK_SECRET=
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET=

# Stripe billing (placeholders only — never commit live secrets)
# Leave STRIPE_SECRET empty to keep the local plan-swap provider for tests/demo.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Optional: map seeded plans to Stripe Price IDs (or set them in Admin → Plans)
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=

# Google OAuth (Auth → Continue with Google). Redirect URI must match Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# AI generation (placeholders only — never commit real keys)
# The key is read here or from the encrypted ai_settings row and is never
# returned to the dashboard. Configure the rest in Admin → AI.
AI_ENABLED=false
# openai | anthropic | kimi | openai_compatible
AI_PROVIDER=openai
AI_MODEL=gpt-5.6
AI_API_KEY=
# Required for openai_compatible (Azure gateway, OpenRouter, Ollama, vLLM, …)
# Kimi defaults to https://api.moonshot.ai/v1 when AI_PROVIDER=kimi
AI_BASE_URL=
AI_MAX_TOKENS=8000
AI_TEMPERATURE=0.7
AI_TIMEOUT=180
AI_MAX_SECTIONS=14

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8090
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

HORIZON_NAME=uidesired
HORIZON_PATH=horizon
