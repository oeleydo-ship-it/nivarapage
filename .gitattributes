* text=auto eol=lf

# Files that are executed inside Linux containers must keep LF endings even
# when the repository is cloned on Windows with core.autocrlf=true.
*.sh text eol=lf
*.conf text eol=lf
*.ini text eol=lf
Dockerfile* text eol=lf
Caddyfile text eol=lf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.sqlite binary
