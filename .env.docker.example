APP_NAME=UiDesired
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.localhost:8088
FRONTEND_URL=http://app.localhost:8088
RENDERER_URL=http://sites.localhost:8088
PLATFORM_DOMAIN=sites.localhost
PREVIEW_DOMAIN=preview.localhost
INTERNAL_RENDERER_SECRET=
SEED_DEMO=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=uidesired
DB_USERNAME=uidesired
DB_PASSWORD=secret

MYSQL_DATABASE=uidesired
MYSQL_USER=uidesired
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
MEDIA_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@uidesired.test"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=app.localhost:8088,localhost:5174

DOMAIN_PROVIDER=fake
CLOUDFLARE_SAAS_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_FALLBACK_ORIGIN=fallback.sites.localhost
CLOUDFLARE_WEBHOOK_SECRET=
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET=

# Stripe (placeholders). Empty STRIPE_SECRET keeps local plan swaps.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# AI generation (placeholders). Configure provider/model in Admin → AI.
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

REVERB_APP_ID=uidesired
REVERB_APP_KEY=uidesiredkey
REVERB_APP_SECRET=uidesiredsecret
REVERB_HOST=laravel-reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

HORIZON_NAME=uidesired
HORIZON_PATH=horizon

API_URL=http://laravel-api:8000
