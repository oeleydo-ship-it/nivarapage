**/node_modules
**/vendor
**/.next
**/dist
**/.git
**/.env
**/.env.*
!**/.env.example
!**/.env.docker.example
**/storage/logs
**/storage/framework/cache/data
**/coverage
**/playwright-report
**/test-results
**/*.md
!docs/**
!.github/**

# Local development state must never be baked into an image. The build context
# is the working tree, not the git index, so .gitignore does not cover this.
apps/api/database/*.sqlite
apps/api/storage/app/public/media
apps/api/storage/app/private/**
!apps/api/storage/app/private/.gitignore
apps/api/storage/framework/sessions/*
apps/api/storage/framework/views/*
apps/api/storage/tmp
apps/api/public/storage
# Regenerated by `composer install` (package:discover) inside the image.
apps/api/bootstrap/cache/*.php

# Scratch files from local probing.
tmp-*
